{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formix-desktop",
  "version": "0.1.0",
  "identifier": "com.mark.formix-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "width": 450,
        "height": 250,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": true,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/Logo512x512.png"]
  }
}
